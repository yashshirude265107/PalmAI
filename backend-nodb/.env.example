# # ============================================================================
# # PalmAI backend — database-free build
# # Only JWT_SECRET needs a real value to run. Everything else below is
# # OPTIONAL: if left blank, the app automatically falls back to local disk
# # storage for images and a mock AI reading, so you can try the full flow
# # with zero external accounts.
# # ============================================================================

# # Server
# PORT=5000
# NODE_ENV=development
# CLIENT_URL=http://localhost:3000

# # JWT — REQUIRED. Any long random string works.
# JWT_SECRET=change_this_to_a_long_random_secret
# JWT_EXPIRES_IN=7d

# # OpenAI — OPTIONAL. Leave blank to get a mock demo reading instead of real AI analysis.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# # Cloudinary — OPTIONAL. Leave blank to store uploaded images on local disk instead.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# # Google OAuth — OPTIONAL. Leave blank to disable the "Sign in with Google" button.
# GOOGLE_CLIENT_ID=

# # Rate limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100


PORT=5000

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

JWT_SECRET=your_jwt_secret_here